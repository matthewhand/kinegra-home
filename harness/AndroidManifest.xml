<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.metaxy.proof">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local ADB uses outbound loopback only. No network listener.
    Former zero-permission dashboard: App choices remain local; only visible launcher activities may be selected. -->
    <!-- Android 11 visibility: explicit shortcuts plus local launcher discovery for user-selected pairs. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="au.private.omegaprime.tegra" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.valvesoftware.steamlink" />
        <package android:name="com.nvidia.tegrazone3" />
        <package android:name="eu.chainfire.tv.sideloadlauncher" />
        <package android:name="local.shieldcam" />
        <package android:name="org.local.tegramilkdrop" />
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.DREAM_SETTINGS" /></intent>
    </queries>
    <application android:label="@string/app_name"
        android:banner="@drawable/metaxy_banner"
        android:icon="@drawable/metaxy_icon"
        android:allowBackup="false" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".DashboardActivity"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PairActivity" android:exported="true" android:resizeableActivity="true" android:screenOrientation="unspecified" />
        <activity android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" android:name=".PairCanvasActivity" android:excludeFromRecents="true" android:exported="true" android:resizeableActivity="true" android:screenOrientation="unspecified" android:launchMode="singleTask" android:taskAffinity="tv.metaxy.proof.canvas" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation|uiMode" />
        <service android:name=".SessionShortcutService" android:exported="true" android:label="Kinegra Home session shortcuts" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/session_shortcuts" />
        </service>
        <provider android:name=".WindowBrokerProvider" android:authorities="tv.metaxy.proof.windowbroker" android:exported="true" android:grantUriPermissions="false" />
        <service android:name="tv.metaxy.dream.MetaxyDreamService"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>
            <meta-data android:name="android.service.dream"
                android:resource="@xml/metaxy_dream" />
        </service>
    </application>
</manifest>
